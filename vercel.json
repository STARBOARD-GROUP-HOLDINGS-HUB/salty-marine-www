{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/technology", "destination": "/technology.html" },
    { "source": "/battery-sizing", "destination": "/battery-sizing.html" },
    { "source": "/gyro-kits", "destination": "/gyro-kits.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ]
}
